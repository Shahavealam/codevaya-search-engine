# --- App ---
APP_NAME=codeveya-search-engine
ENV=local
API_PREFIX=/v1
LOG_LEVEL=INFO

# --- MongoDB (Atlas for prod, localhost for local dev) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=codeveya_search

# Atlas Search / Vector Search index names (created in Atlas; see scripts/create_atlas_indexes.py)
ATLAS_SEARCH_INDEX=code_chunks_lexical
ATLAS_VECTOR_INDEX=code_chunks_vector
ATLAS_VECTOR_FIELD=embedding
ATLAS_SEARCH_FIELD=content

# --- Embeddings (OpenAI-compatible abstraction) ---
# provider: openai | hash (hash = deterministic local-dev fallback, no key needed)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_BATCH_SIZE=32

# --- Retrieval weights ---
RRF_K=60
W_LEXICAL=0.30
W_SEMANTIC=0.25
W_SYMBOL=0.20
W_DEPENDENCY=0.15
W_RECENCY=0.10

# --- Context budgets ---
MAX_FILES_DEFAULT=10
MAX_CHUNKS_DEFAULT=8
MAX_TOKENS_DEFAULT=6000
QUERY_TIMEOUT_MS=5000

# --- Indexing ---
INDEX_WORKERS=4

# --- Optional hot cache (MongoDB remains source of truth) ---
REDIS_URL=
CACHE_TTL_SECONDS=300

# --- Security ---
SECRET_REDACT_PATTERNS=
